// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "autosave": "off",
  "project_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "mode": "auto",
        "model": "opus"
      },
      "type": "registry"
    }
  },
  "agent": {
    "dock": "right",
    "sidebar_side": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "disable_ai": false,
  "vim_mode": true,
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },

  // ── ~/.config/nvim/lua/core/options.lua からの移植 ──
  "relative_line_numbers": "enabled", // relativenumber（boolean ではなく enabled/disabled/wrapped）
  "vertical_scroll_margin": 3, // scrolloff = 3
  "current_line_highlight": "all", // cursorline
  "soft_wrap": "editor_width", // wrap
  "tab_size": 2, // shiftwidth / tabstop = 2
  "hard_tabs": false, // expandtab
  "vim": {
    "use_system_clipboard": "always", // clipboard = unnamedplus
    "use_smartcase_find": true, // ignorecase + smartcase
  },
  "edit_predictions": {
    "provider": "copilot",
  }
}
